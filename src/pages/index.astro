---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { getArticlesByLocale } from '../lib/articles';

const articles = await getArticlesByLocale('en');

const tierOrder = { P0: 0, P1: 1, P2: 2, P3: 3 };
const sortedArticles = articles.sort((a, b) => {
  const tierA = tierOrder[a.data.priorityTier ?? 'P3'];
  const tierB = tierOrder[b.data.priorityTier ?? 'P3'];

  if (tierA !== tierB) {
    return tierA - tierB;
  }

  return a.data.title.localeCompare(b.data.title);
});

const plannedCategories = [
  t('home.categoryBloodTests'),
  t('home.categoryHormoneTests'),
  t('home.categoryStdTesting'),
  t('home.categoryVitaminNutrition'),
  t('home.categoryMetabolicHealth'),
  t('home.categoryFertilityTesting'),
  t('home.categoryAtHomeLabKits'),
];

const heroTagline = `\n${t('home.heroTagline')}\n`;
const marketplaceTeaser = `\n${t('home.marketplaceTeaser')}\n`;
---

<Base
  title={t('site.brand')}
  description={t('home.description')}
>
  <section aria-labelledby="hero-title">
    <h1 id="hero-title">{t('site.brand')}</h1>
    <p>{heroTagline}</p>
  </section>

  <section aria-labelledby="guides-title">
    <h2 id="guides-title">{t('home.guidesTitle')}</h2>
    {
      sortedArticles.length > 0 ? (
        <ul>
          {sortedArticles.map((article) => {
            const href = article.data.originalUrl ?? `/${article.id.replace(/^en\//, '').replace(/\.md$/, '')}/`;

            return (
              <li>
                <h3>
                  <a href={href}>{article.data.title}</a>
                  {article.data.draft && <small> {t('article.draftBadge')}</small>}
                </h3>
                {article.data.description && <p>{article.data.description}</p>}
              </li>
            );
          })}
        </ul>
      ) : (
        <p>{t('home.noGuides')}</p>
      )
    }
  </section>

  <section aria-labelledby="marketplace-title">
    <h2 id="marketplace-title">{t('home.marketplaceTitle')}</h2>
    <p>{marketplaceTeaser}</p>
    <ul>
      {plannedCategories.map((category) => <li>{category}</li>)}
    </ul>
  </section>
</Base>
