---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import MarketplaceTeaser from '../components/MarketplaceTeaser.astro';
import RangeMark from '../components/RangeMark.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { getArticlesByLocale } from '../lib/articles';

const articles = await getArticlesByLocale('en');
const tests = await getCollection('tests');
const providers = await getCollection('providers');
const plArticles = await getArticlesByLocale('pl');

const tierOrder = { P0: 0, P1: 1, P2: 2, P3: 3 };
const sortedArticles = articles.sort((a, b) => {
  const tierA = tierOrder[a.data.priorityTier ?? 'P3'];
  const tierB = tierOrder[b.data.priorityTier ?? 'P3'];

  if (tierA !== tierB) {
    return tierA - tierB;
  }

  return a.data.title.localeCompare(b.data.title);
});

const featuredArticles = sortedArticles.slice(0, 9);
const publishedTests = tests.filter((test) => !test.data.draft);
const publishedProviders = providers.filter((provider) => !provider.data.draft);
---

<BaseLayout title={t('site.brand')} description={t('home.description')}>
  <section class="home-hero wrap" aria-labelledby="hero-title">
    <div>
      <div class="home-hero__eyebrow">
        <RangeMark size="md" />
        Laboratory test guide
      </div>
      <h1 id="hero-title">
        Clear explanations for <em>lab test results</em>
      </h1>
      <p>
        Educational guides to laboratory methods, preparation, reference ranges, and interpretation notes, without replacing a visit to a clinician.
      </p>
      <form class="home-search" action="#articles">
        <input type="search" name="q" placeholder="Search guides, for example blood glucose or ABO grouping" />
        <button type="submit">Find</button>
      </form>
    </div>

    <div class="home-graphic" aria-label="Reference range examples">
      <div class="home-graphic__row">
        <div class="home-graphic__label">Glucose</div>
        <div class="home-graphic__track">
          <div class="home-graphic__band home-graphic__band--a"></div>
          <div class="home-graphic__marker home-graphic__marker--a"></div>
        </div>
      </div>
      <div class="home-graphic__row">
        <div class="home-graphic__label">Urea</div>
        <div class="home-graphic__track">
          <div class="home-graphic__band home-graphic__band--b"></div>
          <div class="home-graphic__marker home-graphic__marker--b"></div>
        </div>
      </div>
      <div class="home-graphic__row">
        <div class="home-graphic__label">CK</div>
        <div class="home-graphic__track">
          <div class="home-graphic__band home-graphic__band--c"></div>
          <div class="home-graphic__marker home-graphic__marker--c"></div>
        </div>
      </div>
      <div class="home-graphic__caption">
        The range mark is the visual language used across guides for normal ranges, outliers, and review notes.
      </div>
    </div>
  </section>

  <div class="wrap home-stats" aria-label="Content statistics">
    <div class="home-stat">
      <div class="home-stat__num mono">{articles.length}</div>
      <div class="home-stat__label">English guides</div>
    </div>
    <div class="home-stat">
      <div class="home-stat__num mono">{plArticles.length}</div>
      <div class="home-stat__label">Polish drafts</div>
    </div>
    <div class="home-stat">
      <div class="home-stat__num mono">{publishedTests.length + publishedProviders.length}</div>
      <div class="home-stat__label">published marketplace listings</div>
    </div>
  </div>

  <section class="section wrap" id="articles" aria-labelledby="guides-title">
    <div class="section-head">
      <h2 id="guides-title">{t('home.guidesTitle')}</h2>
      <span class="count">{articles.length} in articles/en</span>
    </div>
    {
      featuredArticles.length > 0 ? (
        <div class="article-grid">
          {featuredArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <p>{t('home.noGuides')}</p>
      )
    }
  </section>

  <div class="wrap">
    <MarketplaceTeaser />
  </div>
</BaseLayout>

<style>
  .home-hero {
    align-items: center;
    display: grid;
    gap: 40px;
    grid-template-columns: 1.1fr .9fr;
    padding-bottom: 60px;
    padding-top: 76px;
  }

  .home-hero__eyebrow {
    align-items: center;
    color: var(--teal);
    display: flex;
    font-family: var(--font-mono);
    font-size: 12px;
    gap: 8px;
    letter-spacing: .08em;
    margin-bottom: 18px;
    text-transform: uppercase;
  }

  .home-hero h1 {
    font-size: 46px;
    line-height: 1.12;
  }

  .home-hero h1 em {
    color: var(--teal);
    font-style: italic;
  }

  .home-hero p {
    color: var(--ink-soft);
    font-size: 17px;
    margin: 20px 0 28px;
    max-width: 48ch;
  }

  .home-search {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    display: flex;
    max-width: 500px;
    overflow: hidden;
  }

  .home-search input {
    background: transparent;
    border: 0;
    color: var(--ink);
    flex: 1;
    font: inherit;
    min-width: 0;
    outline: 0;
    padding: 14px 16px;
  }

  .home-search button {
    background: var(--teal);
    border: 0;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    padding: 0 20px;
  }

  .home-graphic {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px;
  }

  .home-graphic__row {
    align-items: center;
    display: flex;
    gap: 14px;
    margin-bottom: 22px;
  }

  .home-graphic__label {
    color: var(--ink-soft);
    flex: 0 0 92px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .home-graphic__track {
    background: var(--line);
    border-radius: 4px;
    flex: 1;
    height: 8px;
    position: relative;
  }

  .home-graphic__band,
  .home-graphic__marker {
    position: absolute;
  }

  .home-graphic__band {
    background: var(--teal-tint);
    border-radius: 4px;
    bottom: 0;
    top: 0;
  }

  .home-graphic__marker {
    background: var(--surface);
    border: 3px solid var(--teal);
    border-radius: 50%;
    height: 18px;
    top: -5px;
    width: 18px;
  }

  .home-graphic__band--a {
    left: 30%;
    width: 34%;
  }

  .home-graphic__marker--a {
    left: 44%;
  }

  .home-graphic__band--b {
    left: 25%;
    width: 35%;
  }

  .home-graphic__marker--b {
    border-color: var(--amber);
    left: 66%;
  }

  .home-graphic__band--c {
    left: 20%;
    width: 42%;
  }

  .home-graphic__marker--c {
    left: 37%;
  }

  .home-graphic__caption {
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 13px;
    margin-top: 6px;
    padding-top: 16px;
  }

  .home-stats {
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    display: flex;
    padding-bottom: 26px;
    padding-top: 26px;
  }

  .home-stat {
    border-left: 1px solid var(--line);
    flex: 1;
    padding: 0 24px;
  }

  .home-stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .home-stat__num {
    font-family: var(--font-display);
    font-size: 32px;
  }

  .home-stat__label {
    color: var(--ink-soft);
    font-size: 13px;
    margin-top: 4px;
  }

  .article-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 860px) {
    .home-hero,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .home-stats {
      flex-direction: column;
      gap: 16px;
    }

    .home-stat {
      border-left: 0;
      padding: 0;
    }
  }
</style>
