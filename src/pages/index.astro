---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = await getCollection('articles');
---

<Base title="All Med Tests">
  <h1>Articles</h1>
  {
    articles.length > 0 ? (
      <ul>
        {articles.map((article) => (
          <li>{article.data.title}</li>
        ))}
      </ul>
    ) : (
      <p>No articles yet.</p>
    )
  }
</Base>
