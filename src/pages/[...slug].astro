---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { getArticlesByLocale } from '../lib/articles';

type ArticleEntry = CollectionEntry<'articles'>;

export async function getStaticPaths() {
  const articles = await getArticlesByLocale('en');

  return articles.map((article) => ({
    params: {
      slug: article.data.originalUrl
        ? article.data.originalUrl.replace(/^\/+/, '').replace(/\/+$/, '')
        : article.id.replace(/^en\//, '').replace(/\.md$/, ''),
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
---

<Base title={article.data.title} description={article.data.description}>
  <article>
    <h1>{article.data.title}</h1>
    {article.data.draft && <p><strong>{t('article.draftBadge')}</strong></p>}
    <Content />
  </article>
</Base>
