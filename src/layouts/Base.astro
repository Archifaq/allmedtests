---
import BaseLayout from './BaseLayout.astro';
import type { LocaleCode } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: LocaleCode;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description, locale = 'en', breadcrumbs = [] } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} breadcrumbs={breadcrumbs}>
  <slot />
</BaseLayout>
