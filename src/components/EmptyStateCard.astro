---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="empty-state">
  <span class="empty-state__badge">Soon</span>
  <p>{message}</p>
</div>

<style>
  .empty-state {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: 10px;
    padding: 34px;
    text-align: center;
  }

  .empty-state__badge {
    background: var(--amber-tint);
    border-radius: 20px;
    color: var(--amber);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    margin-bottom: 12px;
    padding: 4px 10px;
  }

  .empty-state p {
    color: var(--ink-soft);
    font-size: 13.5px;
    margin: 0 auto;
    max-width: 52ch;
  }
</style>
